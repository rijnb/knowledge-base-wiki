#!/bin/sh
# Fail-safe pre-push guard.
# Second net behind pre-commit: blocks pushing ANY commit that touches a file
# outside the infrastructure allowlist -- even if pre-commit was bypassed with
# `git commit --no-verify`. Personal notes must never leave this machine.
. "$(dirname "$0")/allowlist.sh"

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch deletion, nothing to check
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"       # new branch: everything not yet on any remote
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  git log --pretty=format: --name-only --diff-filter=ACMR $range \
    | sed '/^$/d' | sort -u | check_paths "pre-push" || status=1
done
exit $status
